{% extends "layout.njk" %}
{% block page_css %}
<style>

.team-page {max-width:980px;margin:0 auto;padding:30px 20px 60px;color:rgb(var(--color_42));}
.team-page .lab-photos {display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:start;}
.team-page figure {margin:0;text-align:center;}
.team-page figure img {display:block;width:100%;height:auto;}
.team-page figcaption {font-size:18px;line-height:1.41;margin-top:12px;}
.team-page #our-team,.team-page #alumni {font-size:40px;line-height:1.35;text-align:center;margin:50px 0 35px;}
.team-page .team-grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:45px 30px;align-items:start;}
.team-page .team-member {text-align:center;min-width:0;}
.team-page .team-member img {width:199px;height:201px;max-width:100%;object-fit:cover;display:block;margin:0 auto 16px;}
.team-page .team-member h2 {font-size:22px;line-height:1.41;margin:0 0 8px;}
.team-page .team-member p {font-size:16px;line-height:1.5;margin:0;}
@media(max-width:600px){.team-page .team-grid,.team-page .lab-photos{grid-template-columns:1fr;}.team-page{padding:24px 20px 45px;}}
/* The static export must scroll as a document, without a viewport-sized background spacer. */
html, body {height:auto !important;min-height:100%;overflow-y:visible !important;}
#BACKGROUND_GROUP {position:absolute !important;top:0;left:0;width:100%;pointer-events:none;}
</style>
{% endblock %}
